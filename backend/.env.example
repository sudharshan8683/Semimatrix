# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (leave blank → runs in-memory mode) ─────────────
MONGODB_URI=

# ─── JWT Secrets (change in production!) ──────────────────────
JWT_ACCESS_SECRET=semimatrix_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=semimatrix_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS (comma-separated origins, or * for all) ─────────────
CORS_ORIGIN=http://localhost:5173

# ─── ML Service (optional) ────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── File Uploads ─────────────────────────────────────────────
DATASET_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_ROWS=100000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
